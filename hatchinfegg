-- ============================================================
-- MEDIUM OBBY LOOP (blocks everything else when running)
-- ============================================================
local function mediumObbyLoop()
    local lastFireAt = 0
    
    while true do
        -- Wait for LocalData
        if not LocalData or not LocalData.IsReady then
            task.wait(1)
            continue
        end
        
        local ok, data = pcall(function() return LocalData:Get() end)
        if not ok or type(data) ~= "table" then
            task.wait(1)
            continue
        end
        
        -- Check if Medium obby is on cooldown
        local cooldowns = data.ObbyCooldowns
        if type(cooldowns) == "table" and isOnCooldown(cooldowns, "Medium") then
            -- On cooldown - keep spamming E (if not blocked by Luck Egg)
            if not _G.Ultimate_LuckEggActive and not spamERunning then
                startSpamE()
            end
            task.wait(1)
            continue
        end
        
        -- STOP SPAMMING E - about to do obby
        if spamERunning then
            stopSpamE()
        end
        
        -- Prevent spamming StartObby too frequently
        local now = tick()
        if now - lastFireAt < 12 then
            task.wait(1)
            continue
        end
        
        -- ============================================================
        -- DO MEDIUM OBBY - BLOCK EVERYTHING ELSE
        -- ============================================================
        _G.Ultimate_ObbyActive = true
        
        -- Teleport to start area
        pcall(function()
            setHRPCFrame(MEDIUM_OBBY.PreStartCFrame)
        end)
        task.wait(0.75)
        
        -- Spam StartObby for 1 second
        local burstEnd = tick() + 1
        while tick() < burstEnd do
            pcall(function() remote:FireServer("StartObby", MEDIUM_OBBY.Name) end)
            task.wait(0)
        end
        
        -- Teleport to Medium island
        task.wait(1)
        pcall(function()
            setHRPCFrame(MEDIUM_OBBY.IslandCFrame)
        end)
        
        -- Wait for obby to complete
        task.wait(3)
        
        -- Reset
        lastFireAt = tick()
        _G.Ultimate_ObbyActive = false
        
        -- ============================================================
        -- OBBY DONE - START SPAMMING E AGAIN (if no Luck Egg)
        -- ============================================================
        if not _G.Ultimate_LuckEggActive and not spamERunning then
            startSpamE()
        end
        
        task.wait(2)
    end
end

