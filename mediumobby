-- Medium Obby Configuration
-- ============================================================
local MEDIUM_OBBY = {
    Name = "Medium",
    PreStartCFrame = CFrame.new(-41529, 10, -20402),
    IslandCFrame = CFrame.new(-1124.33, 5919.76, 22570.72),
}

-- ============================================================
-- Spam E Function (keeps pressing E+R)
-- ============================================================
local spamERunning = false
local spamThread = nil

local function startSpamE()
    if spamERunning then return end
    spamERunning = true
    spamThread = task.spawn(function()
        while spamERunning do
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.01)
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.01)
            VIM:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.01)
            VIM:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            task.wait(0.01)
        end
    end)
end

local function stopSpamE()
    spamERunning = false
    if spamThread then
        spamThread = nil
    end
end

-- ============================================================
-- Main Obby Loop
-- ============================================================
local function mediumObbyLoop()
    local lastFireAt = 0
    local isInObby = false
    
    while true do
        -- Wait for LocalData
        if not LocalData or not LocalData.IsReady then
            task.wait(1)
            continue
        end
        
        local ok, data = pcall(function() return LocalData:Get() end)
        if not ok or type(data) ~= "table" then
            task.wait(1)
            continue
        end
        
        -- Check if Medium obby is on cooldown
        local cooldowns = data.ObbyCooldowns
        if type(cooldowns) == "table" and isOnCooldown(cooldowns, "Medium") then
            -- Still on cooldown - wait and keep spamming E
            if not spamERunning then
                startSpamE()
            end
            task.wait(1)
            continue
        end
        
        -- STOP SPAMMING E - about to do obby
        if spamERunning then
            stopSpamE()
        end
        
        -- Prevent spamming StartObby too frequently
        local now = tick()
        if now - lastFireAt < 12 then
            task.wait(1)
            continue
        end
        
        -- ============================================================
        -- DO MEDIUM OBBY
        -- ============================================================
        isInObby = true
        
        -- Teleport to start area
        pcall(function()
            setHRPCFrame(MEDIUM_OBBY.PreStartCFrame)
        end)
        task.wait(0.75)
        
        -- Spam StartObby for 1 second
        local burstEnd = tick() + 1
        while tick() < burstEnd do
            pcall(function() remote:FireServer("StartObby", MEDIUM_OBBY.Name) end)
            task.wait(0)
        end
        
        -- Teleport to Medium island
        task.wait(1)
        pcall(function()
            setHRPCFrame(MEDIUM_OBBY.IslandCFrame)
        end)
        
        -- Wait for obby to complete (give it time)
        task.wait(3)
        
        -- Reset timestamp
        lastFireAt = tick()
        isInObby = false
        
        -- ============================================================
        -- OBBY DONE - START SPAMMING E AGAIN
        -- ============================================================
        if not spamERunning then
            startSpamE()
        end
        
        -- Wait before checking cooldown again
        task.wait(2)
    end
end

